{"mode":"Text","hardwareTarget":"brain","textContent":"#region VEXcode Generated Robot Configuration\nfrom vex import *\nimport urandom\nimport math\n\n# Brain should be defined by default\nbrain=Brain()\n\n# Robot configuration code\ncontroller_1 = Controller(PRIMARY)\n\n# wait for rotation sensor to fully initialize\nwait(30, MSEC)\n\n# Make random actually random\ndef initializeRandomSeed():\n    wait(100, MSEC)\n    random = brain.battery.voltage(MV) + brain.battery.current(CurrentUnits.AMP) * 100 + brain.timer.system_high_res()\n    urandom.seed(int(random))\n      \n# Set random seed \ninitializeRandomSeed()\n\ndef play_vexcode_sound(sound_name):\n    print(\"VEXPlaySound:\" + sound_name)\n    wait(5, MSEC)\n\n# add a small delay to make sure we don't print in the middle of the REPL header\nwait(200, MSEC)\n# clear the console to make sure we don't have the REPL in the console\nprint(\"\\033[2J\")\n\n#endregion VEXcode Generated Robot Configuration\n\n# ----------------------------\n# Robot Configuration\n# ----------------------------\n\nbrain = Brain()\ncontroller_1 = Controller(PRIMARY)\n\nright_motor = Motor(Ports.PORT2, GearSetting.RATIO_18_1, True)\nleft_motor = Motor(Ports.PORT10, GearSetting.RATIO_18_1, False)\nclaw_motor = Motor(Ports.PORT6, GearSetting.RATIO_18_1, True)\narm_motor = Motor(Ports.PORT5, GearSetting.RATIO_18_1, False)\n\n# ----------------------------\n# Settings\n# ----------------------------\n\nspeed_multiplier = 0.5\n\nARM_HIGH = 586\nARM_MID = 375\nARM_LOW = 110\nARM_RESET = 0\n\nARM_MANUAL_SPEED = 35\nARM_AUTO_MAX_SPEED = 35\nARM_AUTO_MIN_SPEED = 8\nARM_DEADZONE = 5\n\nCLAW_SPEED = 50\n\nARM_STUCK_TORQUE = 1.5\nARM_STUCK_LIMIT = 25\n\n# ----------------------------\n# Setup\n# ----------------------------\n\nwait(30, MSEC)\n\ndef initialize_random_seed():\n    wait(100, MSEC)\n    seed = brain.battery.voltage(MV)\n    seed += brain.battery.current(CurrentUnits.AMP) * 100\n    seed += brain.timer.system_high_res()\n    urandom.seed(int(seed))\n\ninitialize_random_seed()\n\narm_motor.set_stopping(HOLD)\nclaw_motor.set_stopping(HOLD)\nleft_motor.set_stopping(BRAKE)\nright_motor.set_stopping(BRAKE)\n\narm_motor.set_velocity(30, PERCENT)\nclaw_motor.set_velocity(50, PERCENT)\n\n# IMPORTANT:\n# Start robot with arm physically down.\narm_motor.set_position(0, DEGREES)\n\nwait(200, MSEC)\nprint(\"\\033[2J\")\n\n# ----------------------------\n# Utility Helpers\n# ----------------------------\n\ndef clamp(value, low, high):\n    if value < low:\n        return low\n    if value > high:\n        return high\n    return value\n\ndef stop_drive():\n    left_motor.stop(BRAKE)\n    right_motor.stop(BRAKE)\n\ndef cancel_all():\n    arm_motor.stop(HOLD)\n    claw_motor.stop(HOLD)\n    stop_drive()\n\ndef screen_line(row, text):\n    brain.screen.set_cursor(row, 1)\n    brain.screen.print(str(text) + \"                    \")\n\n# ----------------------------\n# Auto Arm Control\n# ----------------------------\n\narm_target = None\narm_stuck_count = 0\n\ndef set_arm_target(target):\n    global arm_target\n    global arm_stuck_count\n\n    arm_target = target\n    arm_stuck_count = 0\n\ndef cancel_arm_target():\n    global arm_target\n    global arm_stuck_count\n\n    arm_target = None\n    arm_stuck_count = 0\n    arm_motor.stop(HOLD)\n\ndef update_arm_auto():\n    global arm_target\n    global arm_stuck_count\n\n    if arm_target is None:\n        return\n\n    pos = arm_motor.position(DEGREES)\n    error = arm_target - pos\n\n    if abs(error) <= ARM_DEADZONE:\n        arm_motor.stop(HOLD)\n        arm_target = None\n        arm_stuck_count = 0\n        return\n\n    speed = abs(error) * 0.12\n    speed = clamp(speed, ARM_AUTO_MIN_SPEED, ARM_AUTO_MAX_SPEED)\n\n    if error > 0:\n        arm_motor.spin(FORWARD, speed, PERCENT)\n    else:\n        arm_motor.spin(REVERSE, speed, PERCENT)\n\n    torque = arm_motor.torque(TorqueUnits.NM)\n\n    if torque > ARM_STUCK_TORQUE and abs(error) > 20:\n        arm_stuck_count += 1\n    else:\n        arm_stuck_count = 0\n\n    if arm_stuck_count >= ARM_STUCK_LIMIT:\n        cancel_arm_target()\n        screen_line(5, \"ARM AUTO CANCELED\")\n\n# ----------------------------\n# 5x Sequence Macro State Machine\n# ----------------------------\n\nmacro_active = False\nmacro_step = 0\nmacro_step_start = 0\nmacro_loop_count = 0\n\ndef now_ms():\n    return brain.timer.time(MSEC)\n\ndef start_macro():\n    global macro_active, macro_step, macro_step_start, macro_loop_count\n    macro_active = True\n    macro_step = 0\n    macro_loop_count = 0\n    macro_step_start = now_ms()\n\ndef cancel_macro():\n    global macro_active, macro_step\n    macro_active = False\n    macro_step = 0\n    claw_motor.stop(HOLD)\n    stop_drive()\n\ndef next_macro_step():\n    global macro_step, macro_step_start\n    macro_step += 1\n    macro_step_start = now_ms()\n\ndef update_macro():\n    global macro_active, macro_step, macro_step_start, macro_loop_count\n\n    if not macro_active:\n        return\n\n    elapsed = now_ms() - macro_step_start\n\n    # -- AUTO GRAB SEQUENCE --\n    # Step 0: back up slightly\n    if macro_step == 0:\n        left_motor.spin(REVERSE, 35, PERCENT)\n        right_motor.spin(REVERSE, 35, PERCENT)\n        if elapsed >= 300:\n            stop_drive()\n            next_macro_step()\n\n    # Step 1: open claw\n    elif macro_step == 1:\n        claw_motor.spin(FORWARD, 50, PERCENT)\n        if elapsed >= 500:\n            claw_motor.stop(HOLD)\n            next_macro_step()\n\n    # Step 2: lower arm slightly\n    elif macro_step == 2:\n        set_arm_target(55)\n        next_macro_step()\n\n    # Step 3: wait for arm to reach target\n    elif macro_step == 3:\n        if arm_target is None or elapsed >= 2000:\n            cancel_arm_target()\n            next_macro_step()\n\n    # Step 4: drive forward\n    elif macro_step == 4:\n        left_motor.spin(FORWARD, 35, PERCENT)\n        right_motor.spin(FORWARD, 35, PERCENT)\n        if elapsed >= 900:\n            stop_drive()\n            next_macro_step()\n\n    # Step 5: close claw (Grab!)\n    elif macro_step == 5:\n        claw_motor.spin(REVERSE, 50, PERCENT)\n        if elapsed >= 1000:\n            claw_motor.stop(HOLD)\n            next_macro_step()\n\n    # Step 6: back up\n    elif macro_step == 6:\n        left_motor.spin(REVERSE, 35, PERCENT)\n        right_motor.spin(REVERSE, 35, PERCENT)\n        if elapsed >= 900:\n            stop_drive()\n            next_macro_step()\n\n    # -- LIFT, TURN, DROP, RETURN SEQUENCE --\n    # Step 7: Lift arm up to High target\n    elif macro_step == 7:\n        set_arm_target(ARM_HIGH)\n        next_macro_step()\n\n    # Step 8: wait for arm to go up\n    elif macro_step == 8:\n        if arm_target is None or elapsed >= 2000:\n            next_macro_step()\n\n    # Step 9: Turn Right ~90 degrees\n    elif macro_step == 9:\n        # TUNE THIS: Change '600' to turn more or less\n        left_motor.spin(FORWARD, 35, PERCENT)\n        right_motor.spin(REVERSE, 35, PERCENT)\n        if elapsed >= 600:\n            stop_drive()\n            next_macro_step()\n\n    # Step 10: Open claw (Drop!)\n    elif macro_step == 10:\n        claw_motor.spin(FORWARD, 50, PERCENT)\n        if elapsed >= 500:\n            claw_motor.stop(HOLD)\n            next_macro_step()\n\n    # Step 11: Turn Left ~90 degrees (Return to center)\n    elif macro_step == 11:\n        # TUNE THIS: Change '600' to match Step 9\n        left_motor.spin(REVERSE, 35, PERCENT)\n        right_motor.spin(FORWARD, 35, PERCENT)\n        if elapsed >= 600:\n            stop_drive()\n            next_macro_step()\n            \n    # Step 12: Lower arm safely before repeating loop\n    elif macro_step == 12:\n        set_arm_target(ARM_RESET)\n        next_macro_step()\n        \n    # Step 13: Wait for arm to go down\n    elif macro_step == 13:\n        if arm_target is None or elapsed >= 1500:\n            next_macro_step()\n\n    # Step 14: Loop Tracker\n    elif macro_step == 14:\n        macro_loop_count += 1\n        if macro_loop_count < 5:\n            # We haven't hit 5 yet, jump back to Step 0\n            macro_step = 0\n            macro_step_start = now_ms()\n        else:\n            # We've done it 5 times, finish up!\n            cancel_macro()\n\n# ----------------------------\n# Driver Control\n# ----------------------------\n\ndef user_control():\n    global arm_target\n\n    was_manual_arm = False\n    r1_was_pressed = False\n    r2_was_pressed = False\n\n    brain.screen.clear_screen()\n    screen_line(1, \"Driver Control Started\")\n\n    while True:\n        try:\n            # ----------------------------\n            # Cancel Button - R2\n            # ----------------------------\n            if controller_1.buttonR2.pressing():\n                cancel_all()\n                cancel_arm_target()\n                cancel_macro()\n                screen_line(5, \"R2 CANCEL\")\n\n                r2_was_pressed = True\n                wait(20, MSEC)\n                continue\n\n            elif r2_was_pressed:\n                r2_was_pressed = False\n                screen_line(5, \"\")\n\n            # ----------------------------\n            # Debug Screen\n            # ----------------------------\n            screen_line(1, \"ARM TORQUE: \" + str(round(arm_motor.torque(TorqueUnits.NM), 2)))\n            screen_line(2, \"ARM DEG: \" + str(int(arm_motor.position(DEGREES))))\n            screen_line(3, \"CLAW DEG: \" + str(int(claw_motor.position(DEGREES))))\n            screen_line(5, \"MACRO LOOP: \" + str(macro_loop_count) + \"/5\")\n\n            if arm_target is None:\n                screen_line(4, \"ARM TARGET: NONE\")\n            else:\n                screen_line(4, \"ARM TARGET: \" + str(int(arm_target)))\n\n            # ----------------------------\n            # R1 Trigger Sequence Macro\n            # ----------------------------\n            if controller_1.buttonR1.pressing() and not r1_was_pressed:\n                start_macro()\n\n            r1_was_pressed = controller_1.buttonR1.pressing()\n\n            # ----------------------------\n            # Drivetrain\n            # ----------------------------\n            if not macro_active:\n                forward = controller_1.axis3.position() * speed_multiplier\n                turn = controller_1.axis1.position() * speed_multiplier\n\n                left_motor.spin(FORWARD, forward + turn, PERCENT)\n                right_motor.spin(FORWARD, forward - turn, PERCENT)\n\n            # ----------------------------\n            # Arm Manual Control\n            # ----------------------------\n            manual_arm = False\n\n            if controller_1.buttonUp.pressing():\n                cancel_arm_target()\n                arm_motor.spin(FORWARD, ARM_MANUAL_SPEED, PERCENT)\n                manual_arm = True\n\n            elif controller_1.buttonDown.pressing():\n                cancel_arm_target()\n                arm_motor.spin(REVERSE, ARM_MANUAL_SPEED, PERCENT)\n                manual_arm = True\n\n            elif was_manual_arm:\n                arm_motor.stop(HOLD)\n\n            was_manual_arm = manual_arm\n\n            # ----------------------------\n            # Arm Presets\n            # ----------------------------\n            if not manual_arm and not macro_active:\n                if controller_1.buttonX.pressing():\n                    set_arm_target(ARM_HIGH)\n\n                elif controller_1.buttonA.pressing():\n                    set_arm_target(ARM_MID)\n\n                elif controller_1.buttonB.pressing():\n                    set_arm_target(ARM_LOW)\n\n                elif controller_1.buttonY.pressing():\n                    set_arm_target(ARM_RESET)\n\n            # ----------------------------\n            # Claw Manual Control\n            # ----------------------------\n            if not macro_active:\n                if controller_1.buttonL2.pressing():\n                    claw_motor.spin(FORWARD, CLAW_SPEED, PERCENT)\n\n                elif controller_1.buttonL1.pressing():\n                    claw_motor.spin(REVERSE, CLAW_SPEED, PERCENT)\n\n                else:\n                    claw_motor.stop(HOLD)\n\n            # ----------------------------\n            # Update Auto Systems\n            # ----------------------------\n            update_arm_auto()\n            update_macro()\n\n        except Exception as error:\n            cancel_all()\n            cancel_arm_target()\n            cancel_macro()\n\n            brain.screen.clear_screen()\n            screen_line(1, \"PROGRAM ERROR\")\n            screen_line(2, str(error))\n\n            wait(500, MSEC)\n\n        wait(20, MSEC)\n\n# ----------------------------\n# Start Program\n# ----------------------------\n\nuser_control()","textLanguage":"python","robotConfig":[{"port":[],"name":"controller_1","customName":false,"deviceType":"Controller","deviceClass":"controller","setting":{"left":"","leftDir":"false","right":"","rightDir":"false","upDown":"","upDownDir":"false","xB":"","xBDir":"false","drive":"none","id":"primary"},"triportSourcePort":22}],"slot":0,"platform":"V5","sdkVersion":"20240802.15.00.00","appVersion":"4.65.0","fileFormat":"2.0.0","targetBrainGen":"First","v5Sounds":[{"name":"game over","url":"static/sounds/mixkit-arcade-retro-game-over-213.wav"}],"v5SoundsEnabled":false,"aiVisionSettings":{"colors":[],"codes":[],"tags":true,"AIObjects":true,"AIObjectModel":[],"aiModelDropDownValue":null}}